<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft drop under the key -->
    <item android:top="2dp">
        <shape android:shape="oval"><solid android:color="@color/w_edge" /></shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/w_key_top" android:endColor="@color/w_key_bottom" />
            <stroke android:width="1dp" android:color="@color/w_edge" />
        </shape>
    </item>
</layer-list>
