<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Kawaii Radio</string>
    <string name="widget_desc">Radio: qo\'shiq, ijro va keyingisi</string>

    <style name="Theme.Kawaii" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch: white logo on black; the Compose splash starts from exactly this frame -->
    <style name="Theme.Kawaii.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Kawaii</item>
    </style>
</resources>
